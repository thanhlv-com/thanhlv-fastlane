# Fastfile - Quản lý Build & Deploy Ứng Dụng Đa Nền Tảng (iOS, macOS, Android/AOS)
# Documentation: https://docs.fastlane.tools/

# 1. Import các helper dùng chung
import "helpers/api_key_helper.rb"
import "helpers/app_config_helper.rb"
import "helpers/cert_helper.rb"
import "helpers/git_workspace_helper.rb"
import "helpers/metadata_helper.rb"

before_all do
  setup_ci if is_ci
end

# Lane tiện ích độc lập (không phụ thuộc platform)
desc "Mã hoá và push App Store Connect API Key lên MATCH_GIT_URL"
lane :push_api_key do |options|
  push_api_key_to_git(options)
end

desc "Dọn dẹp các Certificate & Provisioning Profile cũ/hết hạn trên máy local"
lane :clean_local_certs do |options|
  clean_old_local_certs(options)
end

desc "Dọn dẹp các Provisioning Profile cũ/hết hạn trên máy local"
lane :clean_local_profiles do |options|
  clean_local_provisioning_profiles(options)
end

desc "Chuẩn bị hoặc cập nhật mã nguồn trong .workspace cho 1 app"
lane :prepare_workspace do |options|
  app_key = options[:app] || UI.user_error!("Vui lòng chỉ định app: fastlane prepare_workspace app:OpsFlow_Hub")
  app_info = get_app_config(app_key)
  prepare_app_workspace(app_key, app_info, options)
end

desc "Khởi tạo thư mục và các file Metadata template mẫu cho 1 app"
lane :init_metadata do |options|
  app_key = options[:app] || UI.user_error!("Vui lòng chỉ định app: fastlane init_metadata app:OpsFlow_Hub")
  app_info = get_app_config(app_key)
  init_app_metadata_template(app_key, app_info)
end

desc "Cập nhật (Push/Upload) Metadata từ local lên App Store / Store"
lane :push_metadata do |options|
  app_key = options[:app] || UI.user_error!("Vui lòng chỉ định app: fastlane push_metadata app:OpsFlow_Hub [platform:ios|macos|aos]")
  platform = options[:platform] || "ios"
  upload_app_metadata_to_store(app_key, platform, options)
end

desc "Cập nhật Metadata lên App Store Connect (alias: push_metadata)"
lane :upload_metadata do |options|
  push_metadata(options)
end

desc "Tải (Pull/Download) Metadata từ App Store / Store về máy local để chỉnh sửa"
lane :pull_metadata do |options|
  app_key = options[:app] || UI.user_error!("Vui lòng chỉ định app: fastlane pull_metadata app:OpsFlow_Hub [platform:ios|macos|aos]")
  platform = options[:platform] || "ios"
  download_app_metadata_from_store(app_key, platform, options)
end

desc "Tải Metadata từ App Store Connect về máy local (alias: pull_metadata)"
lane :download_metadata do |options|
  pull_metadata(options)
end

# 2. Import các lane theo từng nền tảng
import "lanes/ios.rb"
import "lanes/macos.rb"
import "lanes/aos.rb"
import "lanes/windows.rb"
import "lanes/linux.rb"
